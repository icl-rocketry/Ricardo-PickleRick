{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PIO Build v3 (absolute)",
            "type": "process",
            "command": "/Users/olivermcnaughton/.platformio/penv/bin/platformio",
            "args": [
                "run",
                "--environment",
                "v3"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "PIO Upload v3 (absolute)",
            "type": "process",
            "command": "/Users/olivermcnaughton/.platformio/penv/bin/platformio",
            "args": [
                "run",
                "--target",
                "upload",
                "--environment",
                "v3",
                "--upload-port",
                "/dev/cu.usbmodem1101"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
